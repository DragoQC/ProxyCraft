@{
    ViewData["Title"] = "Configured proxies";
    ViewData["Page"] = "proxies";
}
<h1 class="page-title">Configured proxies</h1>
<p class="page-description">Domain routes to your local and remote Minecraft servers.</p>
<div class="mt-8 flex items-center justify-between gap-4">
    <form id="proxy-search" role="search" class="w-full max-w-sm">
        <label for="search" class="sr-only">Search proxies</label>
        <input id="search" name="search" class="field" type="search" placeholder="Search proxies…" maxlength="253" />
    </form>
    <button id="add-proxy" type="button" class="button-primary shrink-0" aria-label="Add proxy" title="Add proxy">
        <span aria-hidden="true" class="text-xl leading-5">+</span>
        <span class="hidden sm:inline">Add proxy</span>
    </button>
</div>
<div class="proxy-table card mt-4 md:overflow-x-auto">
    <table role="table" class="w-full text-left text-sm">
        <caption class="sr-only">Configured Minecraft proxies</caption>
        <thead class="table-heading text-xs text-muted">
            <tr>
                <th scope="col" class="px-6 py-4 font-medium">Domain</th>
                <th scope="col" class="px-6 py-4 font-medium">Destination</th>
                <th scope="col" class="px-6 py-4 font-medium">Status</th>
                <th scope="col" class="px-4 py-4 text-right font-medium">Connections</th>
                <th scope="col" class="px-6 py-4 text-right font-medium">Actions</th>
            </tr>
        </thead>
        <tbody id="proxy-list">
            <tr>
                <td colspan="5" class="px-6 py-12 text-center text-muted">Loading proxies…</td>
            </tr>
        </tbody>
    </table>
</div>
<p class="mt-3 text-xs text-muted">Click a domain to copy it. Connection counts refresh every 5 seconds. Active means the destination TCP port responds; checked every 10 seconds.</p>
<p id="proxy-feedback" role="status" class="mt-2 min-h-5 text-sm text-accent">
</p>
<dialog id="proxy-dialog" aria-labelledby="proxy-dialog-title" class="mx-auto mt-[6dvh] max-h-[88dvh] w-full max-w-lg overflow-y-auto rounded-xl app-dialog p-6 text-primary shadow-lg [scrollbar-color:var(--border-strong)_var(--surface)]">
    <h2 id="proxy-dialog-title" class="text-lg font-semibold">Add proxy</h2>
    <p class="mt-2 text-sm text-muted">Saving applies immediately. Changing a Minecraft route disconnects its players; changing only RCON forwarding resets its RCON sessions. Other routes stay connected.</p>
    <form id="proxy-create" method="post" asp-antiforgery="false" class="mt-6 space-y-5">
        <div>
            <label for="domain" class="field-label">Domain</label>
            <input id="domain" name="domain" class="field" required maxlength="253" pattern=".*\..*[^.]\.?" placeholder="play.example.com" autocomplete="off" aria-describedby="domain-error" />
            <p id="domain-error" role="alert" class="mt-2 hidden text-sm text-danger">
            </p>
        </div>
        <div>
            <label for="destinationHost" class="field-label">Destination hostname or IP</label>
            <input id="destinationHost" name="destinationHost" class="field" required maxlength="253" placeholder="192.168.1.10" autocomplete="off" aria-describedby="destination-host-warning" />
            <p id="destination-host-warning" role="status" class="mt-2 hidden text-sm text-secondary">
            </p>
        </div>
        <div>
            <label for="destinationPort" class="field-label">Destination port</label>
            <input id="destinationPort" name="destinationPort" class="field" type="number" min="1" max="65535" value="25565" required />
        </div>
        <label class="flex min-h-11 cursor-pointer items-center gap-3 text-sm text-body">
            <input id="rconEnabled" name="rconEnabled" type="checkbox" role="switch" class="peer sr-only" aria-controls="rcon-forwarding-fields" />
            <span aria-hidden="true" class="relative h-6 w-11 shrink-0 rounded-full bg-muted after:absolute after:left-1 after:top-1 after:size-4 after:rounded-full after:bg-white after:content-[''] peer-checked:bg-accent peer-checked:after:translate-x-5 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-accent motion-safe:after:transition-transform"></span>
            <span>Redirect RCON too</span>
        </label>
        <fieldset id="rcon-forwarding-fields" class="hidden space-y-5" disabled>
            <div>
                <label for="rconListenPort" class="field-label">Public RCON port</label>
                <input id="rconListenPort" name="rconListenPort" class="field" type="number" min="1" max="65535" value="25575" required aria-describedby="rcon-public-hint" />
                <p id="rcon-public-hint" class="mt-2 text-xs text-muted">The port clients connect to on ProxyCraft. Each enabled proxy needs a different public RCON port, separate from the Minecraft listener.</p>
            </div>
            <div>
                <label for="rconDestinationPort" class="field-label">Backend RCON port</label>
                <input id="rconDestinationPort" name="rconDestinationPort" class="field" type="number" min="1" max="65535" value="25575" required />
                <p class="mt-2 text-xs text-muted">Forward to this RCON port on the destination host above. Enable RCON and set its password on that Minecraft server.</p>
            </div>
            <p class="text-xs text-muted">Use the Minecraft domain with this public RCON port. Forward that TCP port to ProxyCraft if crossing a router. RCON is unencrypted; use a trusted network or VPN, or restrict access with your firewall.</p>
        </fieldset>
        <p id="proxy-create-error" role="alert" class="hidden text-sm text-danger">
        </p>
        <div class="flex justify-end gap-3">
            <button id="cancel-proxy" type="button" class="button-secondary">Cancel</button>
            <button type="submit" class="button-primary" disabled>Save proxy</button>
        </div>
    </form>
</dialog>
<dialog id="events-dialog" aria-labelledby="events-dialog-title" aria-describedby="events-description" class="connection-dialog mx-auto mt-[6dvh] max-h-[84dvh] w-full overflow-hidden rounded-xl app-dialog p-5 text-primary shadow-lg sm:p-6">
    <div class="flex shrink-0 items-start justify-between gap-4">
        <div class="min-w-0">
            <h2 id="events-dialog-title" class="text-lg font-semibold">Connection attempts</h2>
            <p id="events-domain" class="mt-1 [overflow-wrap:anywhere] text-sm text-accent">
            </p>
        </div>
        <button id="close-events" type="button" class="button-secondary shrink-0">Close</button>
    </div>
    <p id="events-description" class="mt-4 shrink-0 text-sm text-muted">Latest 20 login attempts for this proxy. Names are supplied by clients; these are not confirmed joins. Server-list pings are excluded.</p>
    <p id="events-status" role="status" class="mt-4 shrink-0 text-sm text-muted">
    </p>
    <p id="events-error" role="alert" class="mt-4 shrink-0 text-sm text-danger">
    </p>
    <ul id="connection-events" tabindex="0" class="mt-2 min-h-0 overflow-y-auto overscroll-contain" aria-label="Recent player connection attempts">
    </ul>
</dialog>
